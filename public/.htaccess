Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Send www and plain http to https://thnchurch.org (needs AutoSSL active in cPanel)
  RewriteCond %{HTTP_HOST} ^www\.thnchurch\.org$ [NC]
  RewriteRule ^ https://thnchurch.org%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Never route API calls to the React app
  RewriteRule ^api/ - [L]

  # Single-page app: send every other unknown path to index.html
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Hashed build files can be cached for a year; index.html must always be fresh
  <FilesMatch "\.(js|css|woff2?|svg|png|jpe?g|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
